# --- miext/sync ---
MIEXT_SYNC_SRCS := misync.c misyncfd.c
MIEXT_SYNC_OBJS := $(MIEXT_SYNC_SRCS:%.c=$(OBJDIR)/miext/sync/%.o)

# --- miext/rootless ---
MIEXT_ROOTLESS_SRCS := rootlessCommon.c rootlessGC.c rootlessScreen.c \
	rootlessValTree.c rootlessWindow.c
MIEXT_ROOTLESS_OBJS := $(MIEXT_ROOTLESS_SRCS:%.c=$(OBJDIR)/miext/rootless/%.o)

# ---------------------------------------------------------------------------
# All objects
# ---------------------------------------------------------------------------
ALL_OBJS := $(PROJECTROOT)/pthreadlight/pthreadlight.o \
	$(DIX_OBJS) $(OS_OBJS) $(FB_OBJS) $(MI_OBJS) $(XEXT_OBJS) \
	$(XKB_OBJS) $(XI_OBJS) $(RENDER_OBJS) $(RANDR_OBJS) $(RECORD_OBJS) \
	$(DBE_OBJS) $(DAMAGEEXT_OBJS) $(COMPOSITE_OBJS) $(PRESENT_OBJS) \
	$(CONFIG_OBJS) $(PSEUDORAMIX_OBJS) $(XFIXES_OBJS) $(GLX_OBJS) \
	$(GLX_WIN_OBJS) $(XWIN_OBJS) $(XWIN_RES) $(WINCLIP_OBJS) \
	$(MIEXT_DAMAGE_OBJS) $(MIEXT_SHADOW_OBJS) \
	$(MIEXT_SYNC_OBJS) $(MIEXT_ROOTLESS_OBJS) \
	$(GIFLIB_OBJS)

ALL_OBJS += $(OBJDIR)/dix/initatoms.o

# Object directory list
OBJ_SUBDIRS := $(sort $(dir $(ALL_OBJS)))

# ---------------------------------------------------------------------------
# Extra per-directory includes
# ---------------------------------------------------------------------------
$(DIX_OBJS):            CFLAGS += -I$(TOPSRCDIR)/composite -I$(TOPSRCDIR)/miext/sync
$(OS_OBJS):             CFLAGS += -I$(TOPSRCDIR)/dix
$(XEXT_OBJS):           CFLAGS += -I$(TOPSRCDIR)/composite -I$(TOPSRCDIR)/miext/sync -I$(TOPSRCDIR)/hw/xfree86/dixmods/extmod
$(DAMAGEEXT_OBJS):      CFLAGS += -I$(TOPSRCDIR)/dix
$(MIEXT_ROOTLESS_OBJS): CFLAGS += -I$(TOPSRCDIR)/dix
$(XWIN_OBJS):           CFLAGS += -I$(TOPSRCDIR)/miext/rootless -I$(TOPSRCDIR)/dix
$(XWIN_OBJS):           CFLAGS += -I$(OBJDIR)/hw/xwin -I$(TOPSRCDIR)/glx -I$(TOPSRCDIR)/hw/xwin/glx
$(GLX_OBJS):            CFLAGS += -I$(TOPSRCDIR)/glx
$(GLX_WIN_OBJS):        CFLAGS += -I$(TOPSRCDIR)/glx -I$(OBJDIR)/hw/xwin/glx -I$(TOPSRCDIR)/hw/xwin/glx
$(XKB_OBJS):            CFLAGS += -I$(TOPSRCDIR)
$(GIFLIB_OBJS):         CFLAGS += -I$(GIFLIB_DIR) -DHAVE_REALLOCARRAY=1
$(WINCLIP_OBJS):        CFLAGS += -I$(GIFLIB_DIR)

$(XKBCOMP_OBJS):        CFLAGS += -I$(XKBCOMP_SRCDIR) \
		-I$(PROJECTROOT)/libX11/include -I$(PROJECTROOT)/libX11/src \
		-I$(PROJECTROOT)/libX11/src/xlibi18n \
		-I$(PROJECTROOT) -I$(DEP_PREFIX)/include
$(OBJDIR)/lcUTF8Load.o:  CFLAGS += -I$(PROJECTROOT)/libX11/modules/lc/Utf8
$(OBJDIR)/lcDefConv.o:   CFLAGS += -I$(PROJECTROOT)/libX11/modules/lc/def
$(OBJDIR)/lcGenConv.o:   CFLAGS += -I$(PROJECTROOT)/libX11/modules/lc/gen

# ---------------------------------------------------------------------------
# Targets
# ---------------------------------------------------------------------------
TARGET := $(OBJDIR)/ming64x.exe

.PHONY: help all clean

help:
	@echo "================================================================================"
	@echo "  ming64x X11 Server — MinGW-w64 build"
	@echo "================================================================================"
	@echo ""
	@echo "  Build targets:"
	@echo "    make -f Makefile.mingw64 all       Build the server (ming64x.exe + xkbcomp.exe)"
	@echo "    make -f Makefile.mingw64 clean     Remove build artifacts"
	@echo ""
	@echo "  Output:"
	@echo "    $(OBJDIR)/ming64x.exe     X11 Server"
	@echo "    $(OBJDIR)/xkbcomp.exe     XKB keymap compiler"
	@echo ""
	@echo "  Install:"
	@echo "    cp $(OBJDIR)/ming64x.exe $(OBJDIR)/xkbcomp.exe ../install/ming64x/"
	@echo ""
	@echo "  Package for deployment:"
	@echo "    cd ../install/ ; zip -r ming64x.zip ming64x"
	@echo ""
	@echo "  Deploy on Windows (run from the install directory):"
	@echo "    cd ming64x && ming64x :0 -listen tcp -ac"
	@echo ""
	@echo "================================================================================"

all: $(TARGET) $(XKBCOMP_TARGET)

$(ALL_OBJS): | $(FIXUP_HEADERS)

$(TARGET): $(ALL_OBJS) $(OBJDIR)/xdmcp_stub.o $(OBJDIR)/all_stubs.o $(OBJDIR)/extensions.o
	@echo "  LINK    $@"
	@$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)


XKBCOMP_SUPPORT := $(TOPSRCDIR)/xkbcomp-support
XCB_ERRORS_SRCDIR := $(PROJECTROOT)/xcb-util-errors/src

$(OBJDIR)/xdmcp_stub.o: $(XKBCOMP_SUPPORT)/xdmcp_stub.c
	@mkdir -p $(OBJDIR)
	@echo "  CC      xdmcp stub"
	@$(CC) -c $(OPT_FLAG) $< -o $@

$(OBJDIR)/all_stubs.o: $(XKBCOMP_SUPPORT)/all_stubs.c
	@mkdir -p $(OBJDIR)
	@echo "  CC      all stubs"
	@$(CC) -c $(OPT_FLAG) $< -o $@

# Generated xcb-errors extension registration (replaces stubs in all_stubs.c)
$(OBJDIR)/extensions.c: $(XCB_ERRORS_SRCDIR)/extensions.py
	@mkdir -p $(OBJDIR)
	@echo "  GEN     $@"
	@python3 $< $@.tmp $(DEP_PREFIX)/share/xcb/*.xml && mv $@.tmp $@

$(OBJDIR)/extensions.o: $(OBJDIR)/extensions.c
	@mkdir -p $(OBJDIR)
	@echo "  CC      $<"
	@$(CC) -c $(OPT_FLAG) -I$(XCB_ERRORS_SRCDIR) -I$(DEP_PREFIX)/include $< -o $@

# ---------------------------------------------------------------------------
# xkbcomp.exe — XKB keymap compiler (console application)
# ---------------------------------------------------------------------------
$(XKBCOMP_TARGET): $(XKBCOMP_OBJS) $(PROJECTROOT)/pthreadlight/pthreadlight.o
	@echo "  LINK    $@"
	@$(CC) $(CFLAGS) $(XKBCOMP_LDFLAGS) -o $@ $^ $(XKBCOMP_WRAPS) $(XKBCOMP_LIBS)

$(OBJDIR)/xlibint_imp_aliases.o: $(XKBCOMP_SUPPORT)/xlibint_imp_aliases.c
	@mkdir -p $(OBJDIR)
	@echo "  CC      xlibint imp aliases"
	@$(CC) -c $(CFLAGS) -I$(DEP_PREFIX)/include -o $@ $<

$(OBJDIR)/debug_wraps.o: $(XKBCOMP_SUPPORT)/debug_wraps.c
	@mkdir -p $(OBJDIR)
	@echo "  CC      debug wraps"
	@$(CC) -c $(CFLAGS) -I$(DEP_PREFIX)/include -o $@ $<

$(OBJDIR)/StrKeysym.o: $(XKBCOMP_SUPPORT)/StrKeysym.c
	@mkdir -p $(OBJDIR)
	@echo "  CC      StrKeysym"
	@$(CC) -c $(CFLAGS) \
		-I$(PROJECTROOT)/libX11/include/X11 \
		-I$(PROJECTROOT)/libX11/include \
		-I$(PROJECTROOT)/libX11/src \
		-I$(PROJECTROOT)/libX11/src/xlibi18n \
		-I$(DEP_PREFIX)/include \
		-o $@ $<

$(OBJDIR)/lcUTF8Load.o: $(PROJECTROOT)/libX11/modules/lc/Utf8/lcUTF8Load.c
	@mkdir -p $(OBJDIR)
	@echo "  CC      lcUTF8Load"
	@$(CC) -c $(CFLAGS) \
		-I$(PROJECTROOT)/libX11/include/X11 \
		-I$(PROJECTROOT)/libX11/include \
		-I$(PROJECTROOT)/libX11/src \
		-I$(PROJECTROOT)/libX11/src/xlibi18n \
		-I$(PROJECTROOT)/libX11/modules/lc/Utf8 \
		-I$(DEP_PREFIX)/include \
		-o $@ $<

$(OBJDIR)/lcDefConv.o: $(PROJECTROOT)/libX11/modules/lc/def/lcDefConv.c
	@mkdir -p $(OBJDIR)
	@echo "  CC      lcDefConv"
	@$(CC) -c $(CFLAGS) \
		-I$(PROJECTROOT)/libX11/include/X11 \
		-I$(PROJECTROOT)/libX11/include \
		-I$(PROJECTROOT)/libX11/src \
		-I$(PROJECTROOT)/libX11/src/xlibi18n \
		-I$(PROJECTROOT)/libX11/modules/lc/def \
		-I$(DEP_PREFIX)/include \
		-o $@ $<

$(OBJDIR)/lcGenConv.o: $(PROJECTROOT)/libX11/modules/lc/gen/lcGenConv.c
	@mkdir -p $(OBJDIR)
	@echo "  CC      lcGenConv"
	@$(CC) -c $(CFLAGS) \
		-I$(PROJECTROOT)/libX11/include/X11 \
		-I$(PROJECTROOT)/libX11/include \
		-I$(PROJECTROOT)/libX11/src \
		-I$(PROJECTROOT)/libX11/src/xlibi18n \
		-I$(PROJECTROOT)/libX11/modules/lc/gen \
		-I$(DEP_PREFIX)/include \
		-o $@ $<

$(OBJDIR)/XlibInt.o: $(PROJECTROOT)/libX11/src/XlibInt.c
	@mkdir -p $(OBJDIR)
	@echo "  CC      XlibInt"
	@$(CC) -c $(CFLAGS) \
		-I$(PROJECTROOT)/libX11/include/X11 \
		-I$(PROJECTROOT)/libX11/include \
		-I$(PROJECTROOT)/libX11/src \
		-I$(PROJECTROOT)/libX11/src/xlibi18n \
		-I$(DEP_PREFIX)/include \
		-o $@ $<

# xkbcomp source files compiled from $(XKBCOMP_SRCDIR)
# NOTE: $(DEFINES) is intentionally NOT passed — it contains server-side
# defines (-DXFree86Server, -DXKB_IN_SERVER) that alter client-library behavior.
$(OBJDIR)/xkbcomp/%.o: $(XKBCOMP_SRCDIR)/%.c
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) $(XKBCOMP_DEFINES) $(INCLUDES) -I$(XKBCOMP_SRCDIR) -c -o $@ $<

# xkbparse — bison-generated parser
$(OBJDIR)/xkbcomp/xkbparse.c $(OBJDIR)/xkbcomp/xkbparse.h: $(XKBCOMP_SRCDIR)/xkbparse.y
	@mkdir -p $(dir $@)
	@echo "  BISON   $<"
	@$(BISON) -d -o $(OBJDIR)/xkbcomp/xkbparse.c $<

$(OBJDIR)/xkbcomp/xkbparse.o: $(OBJDIR)/xkbcomp/xkbparse.c $(OBJDIR)/xkbcomp/xkbparse.h
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) $(XKBCOMP_DEFINES) $(INCLUDES) -I$(XKBCOMP_SRCDIR) -c -o $@ $<

clean:
	rm -rf $(OBJDIR)

# ---------------------------------------------------------------------------
# pthreadlight — minimal pthreads-on-Windows replacement
# ---------------------------------------------------------------------------
$(PROJECTROOT)/pthreadlight/pthreadlight.o: $(PROJECTROOT)/pthreadlight/pthreadlight.c
	@echo "  CC      pthreadlight"
	@$(CC) -c $(OPT_FLAG) -std=gnu99 -D_WIN32_WINNT=0x0601 -o $@ $<

# ---------------------------------------------------------------------------
# Create build directories
# ---------------------------------------------------------------------------
$(OBJ_SUBDIRS):
	mkdir -p $@

# ---------------------------------------------------------------------------
# Implicit rule: source tree .c -> build tree .o
# ---------------------------------------------------------------------------
$(OBJDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) $(DEFINES) $(INCLUDES) -c -o $@ $<

# ---------------------------------------------------------------------------
# Implicit rule: build tree .c -> build tree .o (for generated sources)
# ---------------------------------------------------------------------------
$(OBJDIR)/%.o: $(OBJDIR)/%.c
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) $(DEFINES) $(INCLUDES) -c -o $@ $<

# ---------------------------------------------------------------------------
# Windows resource: .rc -> .o (via windres)
# ---------------------------------------------------------------------------
$(XWIN_RES): $(XWIN_RC) | $(FIXUP_HEADERS)
	@mkdir -p $(dir $@)
	@echo "  WINDRES $<"
	@$(WINDRES) $(DEFINES) --include-dir $(OBJDIR)/include --include-dir . --include-dir $(TOPSRCDIR)/include --include-dir $(PROJECTROOT) --include-dir $(TOPSRCDIR)/hw/xwin -i $< -o $@

# ---------------------------------------------------------------------------
# Explicit rules for generated sources (override pattern rule priority)
# ---------------------------------------------------------------------------
$(OBJDIR)/hw/xwin/winprefslex.o: $(OBJDIR)/hw/xwin/winprefslex.c
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) $(DEFINES) $(INCLUDES) -c -o $@ $<

$(OBJDIR)/hw/xwin/winprefsyacc.o: $(OBJDIR)/hw/xwin/winprefsyacc.c
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) $(DEFINES) $(INCLUDES) -c -o $@ $<

$(OBJDIR)/dix/initatoms.o: $(OBJDIR)/dix/initatoms.c
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) $(DEFINES) $(INCLUDES) -c -o $@ $<

# ---------------------------------------------------------------------------
# Flex/Bison: winprefs lexer and parser
# ---------------------------------------------------------------------------
$(OBJDIR)/hw/xwin/winprefslex.c: hw/xwin/winprefslex.l $(OBJDIR)/hw/xwin/winprefsyacc.h
	@mkdir -p $(dir $@)
	@echo "  FLEX    $<"
	@$(FLEX) -o $@ $<

$(OBJDIR)/hw/xwin/winprefsyacc.c $(OBJDIR)/hw/xwin/winprefsyacc.h: hw/xwin/winprefsyacc.y
	@mkdir -p $(dir $@)
	@echo "  BISON   $<"
	@$(BISON) -d -o $(OBJDIR)/hw/xwin/winprefsyacc.c $<

# ---------------------------------------------------------------------------
# Generated source: initatoms.c (needs bash)
# ---------------------------------------------------------------------------
$(OBJDIR)/dix/initatoms.c: dix/generate-atoms dix/BuiltInAtoms
	@mkdir -p $(dir $@)
	@echo "  GEN     $@"
	@bash dix/generate-atoms dix/BuiltInAtoms $@

# ---------------------------------------------------------------------------
# Generated GL/WGL wrappers (needs python3 + lxml)
# ---------------------------------------------------------------------------
GLX_GEN_SCRIPT := hw/xwin/glx/gen_gl_wrappers.py hw/xwin/glx/reg.py

$(OBJDIR)/hw/xwin/glx/generated_gl_wrappers.c: $(GLX_GEN_SCRIPT) hw/xwin/glx/gl.xml glx/dispatch.h
	@mkdir -p $(dir $@)
	@echo "  GEN     $@"
	@cd hw/xwin/glx && python3 gen_gl_wrappers.py -outfile $(abspath $@) -dispatchheader $(abspath glx/dispatch.h) -staticwrappers

$(OBJDIR)/hw/xwin/glx/generated_wgl_wrappers.c: $(GLX_GEN_SCRIPT) hw/xwin/glx/wgl.xml
	@mkdir -p $(dir $@)
	@echo "  GEN     $@"
	@cd hw/xwin/glx && python3 gen_gl_wrappers.py -registry wgl.xml -prefix wgl -outfile $(abspath $@) -preresolve -nodbgcount

$(OBJDIR)/hw/xwin/glx/glwrap.o:     $(OBJDIR)/hw/xwin/glx/generated_gl_wrappers.c
$(OBJDIR)/hw/xwin/glx/wgl_ext_api.o: $(OBJDIR)/hw/xwin/glx/generated_wgl_wrappers.c
