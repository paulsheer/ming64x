# --- hw/xwin/glx (WGL provider) ---
GLX_WIN_SRCS := glwrap.c indirect.c wgl_ext_api.c winpriv.c
GLX_WIN_OBJS := $(GLX_WIN_SRCS:%.c=$(OBJDIR)/hw/xwin/glx/%.o)

# --- hw/xwin (Windows DDX, with GLX) ---
XWIN_SRCS := InitInput.c InitOutput.c winallpriv.c winauth.c winblock.c \
	wincmap.c winconfig.c wincreatewnd.c wincursor.c windialogs.c \
	winengine.c winerror.c winglobals.c winkeybd.c winkeyhook.c winmisc.c \
	winmonitors.c winmouse.c winmsg.c winmsgwindow.c winmultiwindowclass.c \
	winmultiwindowicons.c winos.c winprefs.c winprocarg.c winscrinit.c \
	winshadddnl.c winshadgdi.c wintaskbar.c wintrayicon.c winvalargs.c \
	winwakeup.c winwindow.c winwndproc.c windisplay.c winclipboardinit.c \
	winclipboardwrappers.c winmultiwindowshape.c winmultiwindowwindow.c \
	winmultiwindowwm.c winmultiwindowwndproc.c winSetAppUserModelID.c \
	winrandr.c xdmcphostselect.c
XWIN_OBJS := $(XWIN_SRCS:%.c=$(OBJDIR)/hw/xwin/%.o)

# Windows resource file
XWIN_RES := $(OBJDIR)/hw/xwin/XWin.o
XWIN_RC  := hw/xwin/XWin.rc

# Generated flex/bison files append to XWIN_OBJS
XWIN_OBJS += $(OBJDIR)/hw/xwin/winprefslex.o $(OBJDIR)/hw/xwin/winprefsyacc.o

# --- hw/xwin/winclipboard ---
WINCLIP_SRCS := textconv.c thread.c wndproc.c xevents.c imageconv.c any2any.c dither.c
WINCLIP_OBJS := $(WINCLIP_SRCS:%.c=$(OBJDIR)/hw/xwin/winclipboard/%.o)

# --- giflib ---
GIFLIB_DIR := $(TOPSRCDIR)/giflib
GIFLIB_SRCS := dgif_lib.c egif_lib.c gifalloc.c gif_err.c gif_hash.c quantize.c
GIFLIB_OBJS := $(GIFLIB_SRCS:%.c=$(OBJDIR)/giflib/%.o)

# --- miext/damage ---
MIEXT_DAMAGE_SRCS := damage.c
MIEXT_DAMAGE_OBJS := $(MIEXT_DAMAGE_SRCS:%.c=$(OBJDIR)/miext/damage/%.o)

# --- miext/shadow ---
MIEXT_SHADOW_SRCS := shadow.c sh3224.c shafb4.c shafb8.c shiplan2p4.c \
	shiplan2p8.c shpacked.c shplanar8.c shplanar.c shrot16pack_180.c \
	shrot16pack_270.c shrot16pack_270YX.c shrot16pack_90.c \
	shrot16pack_90YX.c shrot16pack.c shrot32pack_180.c shrot32pack_270.c \
	shrot32pack_90.c shrot32pack.c shrot8pack_180.c shrot8pack_270.c \
	shrot8pack_90.c shrot8pack.c shrotate.c
MIEXT_SHADOW_OBJS := $(MIEXT_SHADOW_SRCS:%.c=$(OBJDIR)/miext/shadow/%.o)

# --- miext/sync ---
MIEXT_SYNC_SRCS := misync.c misyncfd.c
MIEXT_SYNC_OBJS := $(MIEXT_SYNC_SRCS:%.c=$(OBJDIR)/miext/sync/%.o)

# --- miext/rootless ---
MIEXT_ROOTLESS_SRCS := rootlessCommon.c rootlessGC.c rootlessScreen.c \
	rootlessValTree.c rootlessWindow.c
MIEXT_ROOTLESS_OBJS := $(MIEXT_ROOTLESS_SRCS:%.c=$(OBJDIR)/miext/rootless/%.o)

# ---------------------------------------------------------------------------
# All objects
# ---------------------------------------------------------------------------
ALL_OBJS := $(PROJECTROOT)/pthreadlight/pthreadlight.o \
	$(DIX_OBJS) $(OS_OBJS) $(FB_OBJS) $(MI_OBJS) $(XEXT_OBJS) \
	$(XKB_OBJS) $(XI_OBJS) $(RENDER_OBJS) $(RANDR_OBJS) $(RECORD_OBJS) \
	$(DBE_OBJS) $(DAMAGEEXT_OBJS) $(COMPOSITE_OBJS) $(PRESENT_OBJS) \
	$(CONFIG_OBJS) $(PSEUDORAMIX_OBJS) $(XFIXES_OBJS) $(GLX_OBJS) \
	$(GLX_WIN_OBJS) $(XWIN_OBJS) $(XWIN_RES) $(WINCLIP_OBJS) \
	$(MIEXT_DAMAGE_OBJS) $(MIEXT_SHADOW_OBJS) \
	$(MIEXT_SYNC_OBJS) $(MIEXT_ROOTLESS_OBJS) \
	$(GIFLIB_OBJS)

ALL_OBJS += $(OBJDIR)/dix/initatoms.o

# Object directory list
OBJ_SUBDIRS := $(sort $(dir $(ALL_OBJS)))

# ---------------------------------------------------------------------------
# Extra per-directory includes
# ---------------------------------------------------------------------------
$(DIX_OBJS):            CFLAGS += -I$(TOPSRCDIR)/composite -I$(TOPSRCDIR)/miext/sync
$(OS_OBJS):             CFLAGS += -I$(TOPSRCDIR)/dix
$(XEXT_OBJS):           CFLAGS += -I$(TOPSRCDIR)/composite -I$(TOPSRCDIR)/miext/sync -I$(TOPSRCDIR)/hw/xfree86/dixmods/extmod
$(DAMAGEEXT_OBJS):      CFLAGS += -I$(TOPSRCDIR)/dix
$(MIEXT_ROOTLESS_OBJS): CFLAGS += -I$(TOPSRCDIR)/dix
$(XWIN_OBJS):           CFLAGS += -I$(TOPSRCDIR)/miext/rootless -I$(TOPSRCDIR)/dix
$(XWIN_OBJS):           CFLAGS += -I$(OBJDIR)/hw/xwin -I$(TOPSRCDIR)/glx -I$(TOPSRCDIR)/hw/xwin/glx
$(GLX_OBJS):            CFLAGS += -I$(TOPSRCDIR)/glx -D_GLAPI_NO_EXPORTS
$(GLX_WIN_OBJS):        CFLAGS += -I$(TOPSRCDIR)/glx -I$(OBJDIR)/hw/xwin/glx -I$(TOPSRCDIR)/hw/xwin/glx
$(XKB_OBJS):            CFLAGS += -I$(TOPSRCDIR)
$(GIFLIB_OBJS):         CFLAGS += -I$(GIFLIB_DIR) -DHAVE_REALLOCARRAY=1
$(WINCLIP_OBJS):        CFLAGS += -I$(GIFLIB_DIR)

$(XKBCOMP_OBJS):        CFLAGS += -I$(XKBCOMP_SRCDIR) \
		-I$(PROJECTROOT)/libX11/include -I$(PROJECTROOT)/libX11/src \
		-I$(PROJECTROOT)/libX11/src/xlibi18n \
		-I$(PROJECTROOT) -I$(DEP_PREFIX)/include
$(OBJDIR)/lcUTF8Load.o:  CFLAGS += -I$(PROJECTROOT)/libX11/modules/lc/Utf8
$(OBJDIR)/lcDefConv.o:   CFLAGS += -I$(PROJECTROOT)/libX11/modules/lc/def
$(OBJDIR)/lcGenConv.o:   CFLAGS += -I$(PROJECTROOT)/libX11/modules/lc/gen

# ---------------------------------------------------------------------------
# Targets
# ---------------------------------------------------------------------------
TARGET := $(OBJDIR)/ming64x.exe
NUKLEAR_LIB := $(OBJDIR)/libnuklear.a
LAUNCHX_TARGET := $(OBJDIR)/launchx.exe

.PHONY: help all clean install

help:
	@echo "================================================================================"
	@echo "  ming64x X11 Server — MinGW-w64 build"
	@echo "================================================================================"
	@echo ""
	@echo "  Build targets:"
	@echo "    make -f Makefile.mingw64 all       Build the server (ming64x.exe + xkbcomp.exe)"
	@echo "    make -f Makefile.mingw64 CLANG=1 all   Build with clang/lld toolchain (/opt/clang-mingw)"
	@echo "    make -f Makefile.mingw64 CLANG=1 ASAN=1 all   Build with clang + AddressSanitizer (copies runtime DLLs to ../install/ming64x)"
	@echo "    make -f Makefile.mingw64 clean     Remove build artifacts"
	@echo "    make -f Makefile.mingw64 install   Copy to ../install/ming64x/"
	@echo ""
	@echo "  Output:"
	@echo "    $(OBJDIR)/ming64x.exe     X11 Server"
	@echo "    $(OBJDIR)/xkbcomp.exe     XKB keymap compiler"
	@echo "    $(OBJDIR)/launchx.exe     Configuration tool and ssh client"
	@echo ""
	@echo "  Package for deployment:"
	@echo "    cd ../install/ ; zip -r ming64x.zip ming64x"
	@echo ""
	@echo "  Deploy on Windows (run from the install directory):"
	@echo "    cd ming64x && ming64x :0 -listen tcp -ac"
	@echo ""
	@echo "================================================================================"

all: $(TARGET) $(XKBCOMP_TARGET) $(NUKLEAR_LIB) $(LAUNCHX_TARGET) $(LTDLL_LIB) $(SNDFILE_LIB) $(REGEX_LIB) $(PULSE_LIB)

install: all
	mkdir -p ../install/ming64x/
	cp $(OBJDIR)/ming64x.exe ../install/ming64x/
	cp $(OBJDIR)/xkbcomp.exe ../install/ming64x/
	cp $(OBJDIR)/launchx.exe ../install/ming64x/

ifeq ($(ASAN),1)
# ASAN runtime DLLs ship with the clang-mingw toolchain; copy them next to the
# installed server so an ASAN build can run on Windows (see /opt/clang-mingw/INSTALL).
ASAN_RT_BIN  := $(CLANG_PREFIX)/../$(patsubst %-,%,$(CROSS))/bin
ASAN_RT_DLLS := libclang_rt.asan_dynamic-x86_64.dll libc++.dll libunwind.dll libwinpthread-1.dll
ASAN_INSTALL_DIR := $(PROJECTROOT)/install/ming64x
ASAN_DLLS    := $(addprefix $(ASAN_INSTALL_DIR)/,$(ASAN_RT_DLLS))

all: $(ASAN_DLLS)

$(ASAN_DLLS): $(ASAN_INSTALL_DIR)/%: $(ASAN_RT_BIN)/%
	@mkdir -p $(dir $@)
	@cp $< $@
endif

$(ALL_OBJS): | $(FIXUP_HEADERS)

$(TARGET): $(ALL_OBJS) $(OBJDIR)/xdmcp_stub.o $(OBJDIR)/all_stubs.o $(OBJDIR)/extensions.o
	@echo "  LINK    $@"
	@$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $^ $(LIBS)


XKBCOMP_SUPPORT := $(TOPSRCDIR)/xkbcomp-support
XCB_ERRORS_SRCDIR := $(PROJECTROOT)/xcb-util-errors/src

$(OBJDIR)/xdmcp_stub.o: $(XKBCOMP_SUPPORT)/xdmcp_stub.c
	@mkdir -p $(OBJDIR)
	@echo "  CC      xdmcp stub"
	@$(CC) -c $(OPT_FLAG) $< -o $@

$(OBJDIR)/all_stubs.o: $(XKBCOMP_SUPPORT)/all_stubs.c
	@mkdir -p $(OBJDIR)
	@echo "  CC      all stubs"
	@$(CC) -c $(OPT_FLAG) $< -o $@

# Generated xcb-errors extension registration (replaces stubs in all_stubs.c)
$(OBJDIR)/extensions.c: $(XCB_ERRORS_SRCDIR)/extensions.py
	@mkdir -p $(OBJDIR)
	@echo "  GEN     $@"
	@python3 $< $@.tmp $(DEP_PREFIX)/share/xcb/*.xml && mv $@.tmp $@

$(OBJDIR)/extensions.o: $(OBJDIR)/extensions.c
	@mkdir -p $(OBJDIR)
	@echo "  CC      $<"
	@$(CC) -c $(OPT_FLAG) -I$(XCB_ERRORS_SRCDIR) -I$(DEP_PREFIX)/include $< -o $@

# ---------------------------------------------------------------------------
# xkbcomp.exe — XKB keymap compiler (console application)
# ---------------------------------------------------------------------------
$(XKBCOMP_TARGET): $(XKBCOMP_OBJS) $(PROJECTROOT)/pthreadlight/pthreadlight.o
	@echo "  LINK    $@"
	@$(CC) $(CFLAGS) $(XKBCOMP_LDFLAGS) -o $@ $^ $(XKBCOMP_WRAPS) $(XKBCOMP_LIBS)

$(OBJDIR)/xlibint_imp_aliases.o: $(XKBCOMP_SUPPORT)/xlibint_imp_aliases.c
	@mkdir -p $(OBJDIR)
	@echo "  CC      xlibint imp aliases"
	@$(CC) -c $(CFLAGS) -I$(DEP_PREFIX)/include -o $@ $<

$(OBJDIR)/debug_wraps.o: $(XKBCOMP_SUPPORT)/debug_wraps.c
	@mkdir -p $(OBJDIR)
	@echo "  CC      debug wraps"
	@$(CC) -c $(CFLAGS) -I$(DEP_PREFIX)/include -o $@ $<

$(OBJDIR)/StrKeysym.o: $(XKBCOMP_SUPPORT)/StrKeysym.c
	@mkdir -p $(OBJDIR)
	@echo "  CC      StrKeysym"
	@$(CC) -c $(CFLAGS) \
		-I$(PROJECTROOT)/libX11/include/X11 \
		-I$(PROJECTROOT)/libX11/include \
		-I$(PROJECTROOT)/libX11/src \
		-I$(PROJECTROOT)/libX11/src/xlibi18n \
		-I$(DEP_PREFIX)/include \
		-o $@ $<

$(OBJDIR)/lcUTF8Load.o: $(PROJECTROOT)/libX11/modules/lc/Utf8/lcUTF8Load.c
	@mkdir -p $(OBJDIR)
	@echo "  CC      lcUTF8Load"
	@$(CC) -c $(CFLAGS) \
		-I$(PROJECTROOT)/libX11/include/X11 \
		-I$(PROJECTROOT)/libX11/include \
		-I$(PROJECTROOT)/libX11/src \
		-I$(PROJECTROOT)/libX11/src/xlibi18n \
		-I$(PROJECTROOT)/libX11/modules/lc/Utf8 \
		-I$(DEP_PREFIX)/include \
		-o $@ $<

$(OBJDIR)/lcDefConv.o: $(PROJECTROOT)/libX11/modules/lc/def/lcDefConv.c
	@mkdir -p $(OBJDIR)
	@echo "  CC      lcDefConv"
	@$(CC) -c $(CFLAGS) \
		-I$(PROJECTROOT)/libX11/include/X11 \
		-I$(PROJECTROOT)/libX11/include \
		-I$(PROJECTROOT)/libX11/src \
		-I$(PROJECTROOT)/libX11/src/xlibi18n \
		-I$(PROJECTROOT)/libX11/modules/lc/def \
		-I$(DEP_PREFIX)/include \
		-o $@ $<

$(OBJDIR)/lcGenConv.o: $(PROJECTROOT)/libX11/modules/lc/gen/lcGenConv.c
	@mkdir -p $(OBJDIR)
	@echo "  CC      lcGenConv"
	@$(CC) -c $(CFLAGS) \
		-I$(PROJECTROOT)/libX11/include/X11 \
		-I$(PROJECTROOT)/libX11/include \
		-I$(PROJECTROOT)/libX11/src \
		-I$(PROJECTROOT)/libX11/src/xlibi18n \
		-I$(PROJECTROOT)/libX11/modules/lc/gen \
		-I$(DEP_PREFIX)/include \
		-o $@ $<

$(OBJDIR)/XlibInt.o: $(PROJECTROOT)/libX11/src/XlibInt.c
	@mkdir -p $(OBJDIR)
	@echo "  CC      XlibInt"
	@$(CC) -c $(CFLAGS) \
		-I$(PROJECTROOT)/libX11/include/X11 \
		-I$(PROJECTROOT)/libX11/include \
		-I$(PROJECTROOT)/libX11/src \
		-I$(PROJECTROOT)/libX11/src/xlibi18n \
		-I$(DEP_PREFIX)/include \
		-o $@ $<

# xkbcomp source files compiled from $(XKBCOMP_SRCDIR)
# NOTE: $(DEFINES) is intentionally NOT passed — it contains server-side
# defines (-DXFree86Server, -DXKB_IN_SERVER) that alter client-library behavior.
$(OBJDIR)/xkbcomp/%.o: $(XKBCOMP_SRCDIR)/%.c
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) $(XKBCOMP_DEFINES) $(INCLUDES) -I$(XKBCOMP_SRCDIR) -c -o $@ $<

# xkbparse — bison-generated parser
$(OBJDIR)/xkbcomp/xkbparse.c $(OBJDIR)/xkbcomp/xkbparse.h: $(XKBCOMP_SRCDIR)/xkbparse.y
	@mkdir -p $(dir $@)
	@echo "  BISON   $<"
	@$(BISON) -d -o $(OBJDIR)/xkbcomp/xkbparse.c $<

$(OBJDIR)/xkbcomp/xkbparse.o: $(OBJDIR)/xkbcomp/xkbparse.c $(OBJDIR)/xkbcomp/xkbparse.h
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) $(XKBCOMP_DEFINES) $(INCLUDES) -I$(XKBCOMP_SRCDIR) -c -o $@ $<

clean:
	rm -rf $(OBJDIR)
	rm -f $(PROJECTROOT)/pthreadlight/*.o $(PROJECTROOT)/zlib/*.o

# ---------------------------------------------------------------------------
# pthreadlight — minimal pthreads-on-Windows replacement
# ---------------------------------------------------------------------------
$(PROJECTROOT)/pthreadlight/pthreadlight.o: $(PROJECTROOT)/pthreadlight/pthreadlight.c
	@echo "  CC      pthreadlight"
	@$(CC) -c $(OPT_FLAG) -std=gnu99 -D_WIN32_WINNT=0x0601 -o $@ $<

# ---------------------------------------------------------------------------
# Nuklear — immediate-mode GUI library (static library, not linked into server)
# ---------------------------------------------------------------------------
NUKLEAR_OBJ := $(OBJDIR)/Nuklear/nuklear.o

$(NUKLEAR_OBJ): Nuklear/nuklear.c Nuklear/nukleardefault.h Nuklear/nuklear.h
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) -c -o $@ $<

$(NUKLEAR_LIB): $(NUKLEAR_OBJ)
	@echo "  AR      $@"
	@$(AR) rcs $@ $<

# ---------------------------------------------------------------------------
# launchx.exe — standalone Win32 launcher dialog (Nuklear + GDI)
# ---------------------------------------------------------------------------
LAUNCHX_SRC := winconfig/launchx.c
LAUNCHX_OBJ := $(OBJDIR)/winconfig/launchx.o
LAUNCHX_RC  := winconfig/launchx.rc
LAUNCHX_RES := $(OBJDIR)/winconfig/launchx-res.o
TERMINAL_SRC := winconfig/terminal.c
TERMINAL_OBJ := $(OBJDIR)/winconfig/terminal.o
SSH_SRC := winconfig/ssh.c
SSH_OBJ := $(OBJDIR)/winconfig/ssh.o

$(LAUNCHX_OBJ): $(LAUNCHX_SRC) winconfig/terminal.h winconfig/ssh.h winconfig/x_logo_rgb.h
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) -c -o $@ $<

$(TERMINAL_OBJ): $(TERMINAL_SRC) winconfig/terminal.h
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) -c -o $@ $<

$(SSH_OBJ): $(SSH_SRC) winconfig/ssh.h winconfig/terminal.h
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) -c -o $@ $<

# ---------------------------------------------------------------------------
# libssh2 (WinCNG backend) — statically linked into launchx.exe for SSH logins
# ---------------------------------------------------------------------------
# Only the WinCNG backend is built. openssl/libgcrypt/mbedtls/os400qc3 sources
# are omitted. blowfish.c is #included by bcrypt_pbkdf.c (OpenSSH bcrypt KDF),
# so it is NOT a separate compile unit.
LIBSSH2_SRCS := \
	winconfig/agent.c \
	winconfig/bcrypt_pbkdf.c \
	winconfig/chacha.c \
	winconfig/channel.c \
	winconfig/cipher-chachapoly.c \
	winconfig/comp.c \
	winconfig/crypt.c \
	winconfig/global.c \
	winconfig/hostkey.c \
	winconfig/keepalive.c \
	winconfig/kex.c \
	winconfig/knownhost.c \
	winconfig/mac.c \
	winconfig/misc.c \
	winconfig/packet.c \
	winconfig/pem.c \
	winconfig/poly1305.c \
	winconfig/publickey.c \
	winconfig/scp.c \
	winconfig/session.c \
	winconfig/sftp.c \
	winconfig/transport.c \
	winconfig/userauth.c \
	winconfig/userauth_kbd_packet.c \
	winconfig/version.c \
	winconfig/wincng.c

LIBSSH2_OBJS := $(LIBSSH2_SRCS:winconfig/%.c=$(OBJDIR)/winconfig/%.o)

# libssh2 must not inherit the Xserver's -DHAVE_CONFIG_H or Xserver defines;
# it uses its own hand-crafted WinCNG/MinGW configuration.
$(LIBSSH2_OBJS): DEFINES := -DLIBSSH2_WINCNG
$(LIBSSH2_OBJS): INCLUDES := -I$(TOPSRCDIR)/winconfig

$(LAUNCHX_TARGET): $(LAUNCHX_OBJ) $(TERMINAL_OBJ) $(SSH_OBJ) $(NUKLEAR_LIB) $(LIBSSH2_OBJS) $(LAUNCHX_RES)
	@echo "  LINK    $@"
	@$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $(LAUNCHX_OBJ) $(TERMINAL_OBJ) $(SSH_OBJ) $(NUKLEAR_LIB) $(LIBSSH2_OBJS) $(LAUNCHX_RES) -lmsimg32 -lgdi32 -luser32 -lws2_32 -lbcrypt -lcrypt32

# ---------------------------------------------------------------------------
# libltdl (GNU libtool's dlopen wrapper) — static library for pulseaudio
# ---------------------------------------------------------------------------
# Loaders: preopen (static preload) + loadlibrary (Win32 LoadLibrary). The
# latter is registered via lt_dlpreload.c's lt_libltdl_LTX_preloaded_symbols.
LTDLL_DIR := $(PROJECTROOT)/libltdl
LTDLL_SRCS := ltdl.c lt__alloc.c lt__argz.c lt__dirent.c lt__strl.c \
	lt_dlloader.c lt_error.c slist.c lt_dlpreload.c \
	loaders/preopen.c loaders/loadlibrary.c
LTDLL_OBJS := $(LTDLL_SRCS:%.c=$(OBJDIR)/libltdl/%.o)
LTDLL_LIB := $(OBJDIR)/libltdl.a

# libltdl must not inherit the Xserver's -DHAVE_CONFIG_H or server defines;
# it uses its own hand-crafted config.h.
$(LTDLL_OBJS): DEFINES := -DLT_CONFIG_H='<config.h>' -DLTDL -DHAVE_LIBDLLOADER -DLTDLOPEN=libltdl
$(LTDLL_OBJS): INCLUDES := -I$(LTDLL_DIR) -I$(LTDLL_DIR)/libltdl -I$(OBJDIR)/libltdl

# lt__argz.h is generated from lt__argz_.h (libtool does the same in ltdl.mk).
$(OBJDIR)/libltdl/lt__argz.h: $(LTDLL_DIR)/libltdl/lt__argz_.h
	@mkdir -p $(dir $@)
	@echo "  COPY    $< -> $@"
	@cp $< $@

$(OBJDIR)/libltdl/%.o: $(LTDLL_DIR)/%.c | $(OBJDIR)/libltdl/lt__argz.h
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) $(DEFINES) $(INCLUDES) -c -o $@ $<

$(LTDLL_LIB): $(LTDLL_OBJS)
	@echo "  AR      $@"
	@$(AR) rcs $@ $^

# ---------------------------------------------------------------------------
# libsndfile — static library for pulseaudio (built-in codecs only)
# ---------------------------------------------------------------------------
# External codecs (FLAC/Ogg/Vorbis/Opus/Speex/MPEG) are disabled via config.h;
# flac.c/ogg.c/mpeg.c self-stub to SFE_UNIMPLEMENTED. Internal codecs (gsm610,
# g72x, the adpcm family, alac) are compiled unconditionally because sndfile.c's
# dispatch switch references every *_open() without guards.
SNDFILE_DIR := $(PROJECTROOT)/libsndfile
SNDFILE_SRCS := \
	common.c file_io.c command.c pcm.c ulaw.c alaw.c float32.c double64.c \
	ima_adpcm.c ms_adpcm.c gsm610.c dwvw.c vox_adpcm.c interleave.c strings.c \
	dither.c cart.c broadcast.c audio_detect.c ima_oki_adpcm.c alac.c chunk.c \
	ogg.c chanmap.c id3.c windows.c sndfile.c aiff.c au.c avr.c caf.c dwd.c \
	flac.c g72x.c htk.c ircam.c macos.c mat4.c mat5.c nist.c paf.c pvf.c \
	raw.c rx2.c sd2.c sds.c svx.c txw.c voc.c wve.c w64.c wavlike.c wav.c \
	xi.c mpc2k.c rf64.c ogg_vorbis.c ogg_speex.c ogg_pcm.c ogg_opus.c \
	ogg_vcomment.c nms_adpcm.c mpeg.c mpeg_decode.c mpeg_l3_encode.c \
	GSM610/add.c GSM610/code.c GSM610/decode.c GSM610/gsm_create.c \
	GSM610/gsm_decode.c GSM610/gsm_destroy.c GSM610/gsm_encode.c \
	GSM610/gsm_option.c GSM610/long_term.c GSM610/lpc.c GSM610/preprocess.c \
	GSM610/rpe.c GSM610/short_term.c GSM610/table.c \
	G72x/g721.c G72x/g723_16.c G72x/g723_24.c G72x/g723_40.c G72x/g72x.c \
	ALAC/ALACBitUtilities.c ALAC/ag_dec.c ALAC/ag_enc.c ALAC/dp_dec.c \
	ALAC/dp_enc.c ALAC/matrix_dec.c ALAC/matrix_enc.c ALAC/alac_decoder.c \
	ALAC/alac_encoder.c
SNDFILE_OBJS := $(SNDFILE_SRCS:%.c=$(OBJDIR)/libsndfile/%.o)
SNDFILE_LIB := $(OBJDIR)/libsndfile.a

# libsndfile must not inherit the Xserver's -DHAVE_CONFIG_H or server defines;
# it always includes its own src/config.h via sfconfig.h.
$(SNDFILE_OBJS): DEFINES := -D__USE_MINGW_ANSI_STDIO=1
$(SNDFILE_OBJS): INCLUDES := -I$(SNDFILE_DIR)/src -I$(SNDFILE_DIR)/include

$(OBJDIR)/libsndfile/%.o: $(SNDFILE_DIR)/src/%.c
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) $(DEFINES) $(INCLUDES) -c -o $@ $<

$(SNDFILE_LIB): $(SNDFILE_OBJS)
	@echo "  AR      $@"
	@$(AR) rcs $@ $^

# ---------------------------------------------------------------------------
# libregex (glibc-compatible regex for pulseaudio) — replaces pcreposix
# ---------------------------------------------------------------------------
# regex.c is a gnulib combined translation unit (pulls in regex_internal.c,
# regcomp.c, regexec.c); nl_langinfo.c is the langinfo shim. Uses the local
# regex.h/langinfo.h and src/config.h.
REGEX_DIR := $(PROJECTROOT)/libregex
REGEX_SRCS := regex.c nl_langinfo.c
REGEX_OBJS := $(REGEX_SRCS:%.c=$(OBJDIR)/libregex/%.o)
REGEX_LIB := $(OBJDIR)/libregex.a

# libregex must not inherit the Xserver's -DHAVE_CONFIG_H or server defines;
# it includes its own src/config.h via regex_internal.h.
$(REGEX_OBJS): DEFINES := -D__USE_GNU
$(REGEX_OBJS): INCLUDES := -I$(REGEX_DIR)/include -I$(REGEX_DIR)/src

$(OBJDIR)/libregex/%.o: $(REGEX_DIR)/src/%.c
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) $(DEFINES) $(INCLUDES) -c -o $@ $<

$(REGEX_LIB): $(REGEX_OBJS)
	@echo "  AR      $@"
	@$(AR) rcs $@ $^

# ---------------------------------------------------------------------------
# PulseAudio (v17.0) — server-only daemon embedded into ming64x.exe
# ---------------------------------------------------------------------------
# Compiled into a static archive (libpulseaudio-embedded.a) and linked into the
# X server; start_pulseaudio_thread() is called from ming64x.exe. Optional deps
# are all disabled via pulseaudio/config.h; the only external libs are libltdl,
# libsndfile and libregex (all built above).
#
# Modules are compiled with -DPA_MODULE_NAME=<name> (meson's name.underscorify())
# so each module's pa__init/pa__done/pa__get_* symbols are renamed to a unique
# <name>_LTX_pa__*. That uniqueness is what lets every module live in one static
# archive and be resolved through libltdl's preopen loader (see gen-pulse-preload.sh).
PULSE_SRC   := $(PULSE_ROOT)/src
PULSE_OBJ   := $(OBJDIR)/pulseaudio
PULSE_LIB   := $(OBJDIR)/libpulseaudio-embedded.a
PULSE_MAJOR := 17
PULSE_MINOR := 0
PULSE_API   := 12
PULSE_PROTO := 35

# pa_c_args (-DHAVE_CONFIG_H -D_GNU_SOURCE) + embedding/CRT additions. -std=gnu11
# overrides the global -std=gnu99 (meson builds pulseaudio with c_std=gnu11; the
# flag sits after CFLAGS on the command line so the last -std= wins).
# __INCLUDED_FROM_PULSE_AUDIO is meson's server_c_args. It is only defined for
# server-side code (pulsecore core, protocol, modules); it must NOT be defined
# for the client-side files (pulse/*, the libpulsecommon pulsecore set, daemon)
# because pulse/introspect.c needs the client pa_port_available enum that
# pulse/def.h hides when the macro is set.
PULSE_DEFINES        := -DHAVE_CONFIG_H -D_GNU_SOURCE -DEMBEDDED -D__USE_MINGW_ANSI_STDIO=1 -std=gnu11
PULSE_SERVER_DEFINES := $(PULSE_DEFINES) -D__INCLUDED_FROM_PULSE_AUDIO

PULSE_INCLUDES := -I$(PULSE_ROOT) -I$(PULSE_SRC) -I$(PULSE_SRC)/modules \
	-I$(PULSE_OBJ) -I$(REGEX_DIR)/include -I$(SNDFILE_DIR)/include -I$(LTDLL_DIR)

# --- source lists -----------------------------------------------------------
# pulse/*: union of libpulse (25) and the pulse/ files of libpulsecommon (14);
# they overlap on 12 files, so the union is 27.
PULSE_PULSE_SRCS := \
	pulse/channelmap.c pulse/client-conf.c pulse/context.c pulse/direction.c \
	pulse/error.c pulse/ext-device-manager.c pulse/ext-device-restore.c \
	pulse/ext-stream-restore.c pulse/fork-detect.c pulse/format.c \
	pulse/introspect.c pulse/mainloop-api.c pulse/mainloop-signal.c \
	pulse/mainloop.c pulse/operation.c pulse/proplist.c pulse/rtclock.c \
	pulse/sample.c pulse/scache.c pulse/stream.c pulse/subscribe.c \
	pulse/thread-mainloop.c pulse/timeval.c pulse/utf8.c pulse/util.c \
	pulse/volume.c pulse/xmalloc.c

# pulsecore/* shared client+server files (libpulsecommon).
PULSE_COMMON_SRCS := \
	pulsecore/arpa-inet.c pulsecore/aupdate.c pulsecore/authkey.c \
	pulsecore/bitset.c pulsecore/conf-parser.c pulsecore/core-error.c \
	pulsecore/core-format.c pulsecore/core-rtclock.c pulsecore/core-util.c \
	pulsecore/dynarray.c pulsecore/fdsem.c pulsecore/flist.c pulsecore/g711.c \
	pulsecore/hashmap.c pulsecore/i18n.c pulsecore/idxset.c \
	pulsecore/iochannel.c pulsecore/ioline.c pulsecore/ipacl.c pulsecore/json.c \
	pulsecore/lock-autospawn.c pulsecore/log.c pulsecore/mcalign.c \
	pulsecore/memblock.c pulsecore/memblockq.c pulsecore/memchunk.c \
	pulsecore/memtrap.c pulsecore/native-common.c pulsecore/once.c \
	pulsecore/packet.c pulsecore/parseaddr.c pulsecore/pdispatch.c \
	pulsecore/pid.c pulsecore/pipe.c pulsecore/proplist-util.c \
	pulsecore/pstream.c pulsecore/pstream-util.c pulsecore/queue.c \
	pulsecore/random.c pulsecore/ratelimit.c pulsecore/sample-util.c \
	pulsecore/shm.c pulsecore/sndfile-util.c pulsecore/socket-client.c \
	pulsecore/socket-util.c pulsecore/srbchannel.c pulsecore/strbuf.c \
	pulsecore/strlist.c pulsecore/tagstruct.c pulsecore/time-smoother.c \
	pulsecore/time-smoother_2.c pulsecore/tokenizer.c pulsecore/usergroup.c

# Win32 thread/socket shims; present in BOTH libpulsecommon and libpulsecore,
# so they are compiled exactly once here.
PULSE_WIN32_SRCS := \
	pulsecore/mutex-win32.c pulsecore/poll-win32.c \
	pulsecore/semaphore-win32.c pulsecore/thread-win32.c

# pulsecore/* server-side files (libpulsecore) + database-simple + the SIMD
# variants that are not already in the base list (remap_mmx/remap_sse/sconv_sse).
PULSE_CORE_SRCS := \
	pulsecore/asyncmsgq.c pulsecore/asyncq.c pulsecore/auth-cookie.c \
	pulsecore/card.c pulsecore/cli-command.c pulsecore/cli-text.c \
	pulsecore/client.c pulsecore/core.c pulsecore/core-scache.c \
	pulsecore/core-subscribe.c pulsecore/cpu.c pulsecore/cpu-arm.c \
	pulsecore/cpu-orc.c pulsecore/cpu-x86.c pulsecore/database.c \
	pulsecore/database-simple.c pulsecore/device-port.c \
	pulsecore/ffmpeg/resample2.c pulsecore/filter/biquad.c \
	pulsecore/filter/crossover.c pulsecore/filter/lfe-filter.c \
	pulsecore/hook-list.c pulsecore/ltdl-helper.c \
	pulsecore/message-handler.c pulsecore/mix.c pulsecore/modargs.c \
	pulsecore/modinfo.c pulsecore/module.c pulsecore/msgobject.c \
	pulsecore/namereg.c pulsecore/object.c pulsecore/play-memblockq.c \
	pulsecore/play-memchunk.c pulsecore/remap.c pulsecore/remap_mmx.c \
	pulsecore/remap_sse.c pulsecore/resampler.c pulsecore/resampler/ffmpeg.c \
	pulsecore/resampler/peaks.c pulsecore/resampler/trivial.c pulsecore/rtpoll.c \
	pulsecore/sconv.c pulsecore/sconv-s16be.c pulsecore/sconv-s16le.c \
	pulsecore/sconv_sse.c pulsecore/shared.c pulsecore/sink.c \
	pulsecore/sink-input.c pulsecore/sioman.c pulsecore/socket-server.c \
	pulsecore/sound-file.c pulsecore/sound-file-stream.c pulsecore/source.c \
	pulsecore/source-output.c pulsecore/start-child.c pulsecore/stream-util.c \
	pulsecore/svolume_arm.c pulsecore/svolume_c.c pulsecore/svolume_mmx.c \
	pulsecore/svolume_sse.c pulsecore/thread-mq.c

# Protocol implementations (cli + the four protocol-* + mime-type).
PULSE_PROTOCOL_SRCS := \
	pulsecore/cli.c pulsecore/protocol-cli.c pulsecore/protocol-http.c \
	pulsecore/mime-type.c pulsecore/protocol-native.c pulsecore/protocol-simple.c

# The daemon proper.
PULSE_DAEMON_SRCS := \
	daemon/caps.c daemon/cmdline.c daemon/cpulimit.c daemon/daemon-conf.c \
	daemon/dumpmodules.c daemon/ltdl-bind-now.c daemon/main.c

# Shared module helper files (define no pa__* symbols; compiled once).
PULSE_HELPER_SRCS := \
	modules/restart-module.c modules/stream-interaction.c \
	modules/echo-cancel/null.c

# --- object lists -----------------------------------------------------------
PULSE_PULSE_OBJS    := $(PULSE_PULSE_SRCS:%.c=$(PULSE_OBJ)/%.o)
PULSE_COMMON_OBJS   := $(PULSE_COMMON_SRCS:%.c=$(PULSE_OBJ)/%.o)
PULSE_WIN32_OBJS    := $(PULSE_WIN32_SRCS:%.c=$(PULSE_OBJ)/%.o)
PULSE_CORE_OBJS     := $(PULSE_CORE_SRCS:%.c=$(PULSE_OBJ)/%.o)
PULSE_PROTOCOL_OBJS := $(PULSE_PROTOCOL_SRCS:%.c=$(PULSE_OBJ)/%.o)
PULSE_DAEMON_OBJS   := $(PULSE_DAEMON_SRCS:%.c=$(PULSE_OBJ)/%.o)
PULSE_HELPER_OBJS   := $(PULSE_HELPER_SRCS:%.c=$(PULSE_OBJ)/%.o)

PULSE_OBJS := $(PULSE_PULSE_OBJS) $(PULSE_COMMON_OBJS) $(PULSE_WIN32_OBJS) \
	$(PULSE_CORE_OBJS) $(PULSE_PROTOCOL_OBJS) $(PULSE_DAEMON_OBJS)

# Per-group DEFINES (see note above about __INCLUDED_FROM_PULSE_AUDIO).
$(PULSE_PULSE_OBJS):    DEFINES := $(PULSE_DEFINES)
$(PULSE_COMMON_OBJS):   DEFINES := $(PULSE_DEFINES)
$(PULSE_WIN32_OBJS):    DEFINES := $(PULSE_DEFINES)
$(PULSE_DAEMON_OBJS):   DEFINES := $(PULSE_DEFINES)
$(PULSE_CORE_OBJS):     DEFINES := $(PULSE_SERVER_DEFINES)
$(PULSE_PROTOCOL_OBJS): DEFINES := $(PULSE_SERVER_DEFINES)
$(PULSE_HELPER_OBJS):   DEFINES := $(PULSE_SERVER_DEFINES)

$(PULSE_OBJS) $(PULSE_HELPER_OBJS): INCLUDES := $(PULSE_INCLUDES)

# SIMD objects (meson's simd_variants: mmx / sse).
$(PULSE_OBJ)/pulsecore/remap_mmx.o:   CFLAGS += -mmmx
$(PULSE_OBJ)/pulsecore/svolume_mmx.o: CFLAGS += -mmmx
$(PULSE_OBJ)/pulsecore/remap_sse.o:   CFLAGS += -msse2
$(PULSE_OBJ)/pulsecore/svolume_sse.o: CFLAGS += -msse2
$(PULSE_OBJ)/pulsecore/sconv_sse.o:   CFLAGS += -msse2

# Generated header: version.h (included by context.c, daemon-conf.c, protocol-native.c).
$(PULSE_OBJ)/pulse/version.h: $(PULSE_SRC)/pulse/version.h.in
	@mkdir -p $(dir $@)
	@echo "  GEN     $@"
	@sed -e 's/@PA_MAJOR@/$(PULSE_MAJOR)/g' \
	     -e 's/@PA_MINOR@/$(PULSE_MINOR)/g' \
	     -e 's/@PA_API_VERSION@/$(PULSE_API)/g' \
	     -e 's/@PA_PROTOCOL_VERSION@/$(PULSE_PROTO)/g' $< > $@

# Shared compile rule for all non-module pulse objects.
$(PULSE_OBJ)/%.o: $(PULSE_SRC)/%.c | $(PULSE_OBJ)/pulse/version.h
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) $(DEFINES) $(INCLUDES) -c -o $@ $<

# --- modules ----------------------------------------------------------------
# Normal modules: one source file modules/<name>.c, -DPA_MODULE_NAME=<name>
# with '-' -> '_' (meson's name.underscorify()).
define PULSE_MODULE_RULE
PULSE_MODULE_OBJS += $(PULSE_OBJ)/modules/$(1).o
$(PULSE_OBJ)/modules/$(1).o: DEFINES := $(PULSE_SERVER_DEFINES) -DPA_MODULE_NAME=$(subst -,_,$(1))
$(PULSE_OBJ)/modules/$(1).o: INCLUDES := $(PULSE_INCLUDES)
endef

# Protocol-stub modules: all compile modules/module-protocol-stub.c but with a
# distinct -DPA_MODULE_NAME and USE_PROTOCOL_*/USE_*_SOCKETS flag set.
define PULSE_PROTOSTUB_RULE
PULSE_MODULE_OBJS += $(PULSE_OBJ)/modules/$(1).o
$(PULSE_OBJ)/modules/$(1).o: $(PULSE_SRC)/modules/module-protocol-stub.c | $(PULSE_OBJ)/pulse/version.h
	@mkdir -p $(dir $$@)
	@echo "  CC      $$<"
	@$(CC) $(CFLAGS) $(PULSE_SERVER_DEFINES) -DPA_MODULE_NAME=$(subst -,_,$(1)) $(2) $(PULSE_INCLUDES) -c -o $$@ $$<
endef

PULSE_MODULE_NAMES := \
	module-allow-passthrough module-always-sink module-always-source \
	module-augment-properties module-card-restore module-cli module-combine \
	module-combine-sink module-default-device-restore module-detect \
	module-device-manager module-device-restore module-filter-apply \
	module-filter-heuristics module-intended-roles module-loopback module-match \
	module-native-protocol-fd module-null-sink module-null-source \
	module-position-event-sounds module-remap-sink module-remap-source \
	module-rescue-streams module-role-cork module-role-ducking module-sine \
	module-sine-source module-stream-restore module-suspend-on-idle \
	module-switch-on-connect module-switch-on-port-available \
	module-tunnel-sink-new module-tunnel-source-new module-virtual-sink \
	module-virtual-source module-volume-restore module-waveout

$(foreach m,$(PULSE_MODULE_NAMES),$(eval $(call PULSE_MODULE_RULE,$(m))))

$(eval $(call PULSE_PROTOSTUB_RULE,module-cli-protocol-tcp,-DUSE_PROTOCOL_CLI -DUSE_TCP_SOCKETS))
$(eval $(call PULSE_PROTOSTUB_RULE,module-cli-protocol-unix,-DUSE_PROTOCOL_CLI -DUSE_UNIX_SOCKETS))
$(eval $(call PULSE_PROTOSTUB_RULE,module-http-protocol-tcp,-DUSE_PROTOCOL_HTTP -DUSE_TCP_SOCKETS))
$(eval $(call PULSE_PROTOSTUB_RULE,module-http-protocol-unix,-DUSE_PROTOCOL_HTTP -DUSE_UNIX_SOCKETS))
$(eval $(call PULSE_PROTOSTUB_RULE,module-native-protocol-tcp,-DUSE_PROTOCOL_NATIVE -DUSE_TCP_SOCKETS))
$(eval $(call PULSE_PROTOSTUB_RULE,module-native-protocol-unix,-DUSE_PROTOCOL_NATIVE -DUSE_UNIX_SOCKETS))
$(eval $(call PULSE_PROTOSTUB_RULE,module-simple-protocol-tcp,-DUSE_PROTOCOL_SIMPLE -DUSE_TCP_SOCKETS))
$(eval $(call PULSE_PROTOSTUB_RULE,module-simple-protocol-unix,-DUSE_PROTOCOL_SIMPLE -DUSE_UNIX_SOCKETS))

# module-echo-cancel: multi-file (module-echo-cancel.c + null.c, the latter
# already in PULSE_HELPER_SRCS); compiled via the shared pattern rule.
PULSE_MODULE_OBJS += $(PULSE_OBJ)/modules/echo-cancel/module-echo-cancel.o
$(PULSE_OBJ)/modules/echo-cancel/module-echo-cancel.o: DEFINES := $(PULSE_SERVER_DEFINES) -DPA_MODULE_NAME=module_echo_cancel
$(PULSE_OBJ)/modules/echo-cancel/module-echo-cancel.o: INCLUDES := $(PULSE_INCLUDES)

# --- preload table ----------------------------------------------------------
# Scans the module objects for their <name>_LTX_pa__* symbols and emits the
# lt__PROGRAM__LTX_preloaded_symbols table libltdl needs to resolve modules from
# inside the static archive.
$(PULSE_OBJ)/pulse_preload.c: $(PULSE_MODULE_OBJS) $(TOPSRCDIR)/gen-pulse-preload.sh
	@mkdir -p $(dir $@)
	@echo "  GEN     $@"
	@$(NM) -g --defined-only $(PULSE_MODULE_OBJS) | sh $(TOPSRCDIR)/gen-pulse-preload.sh > $@

$(PULSE_OBJ)/pulse_preload.o: $(PULSE_OBJ)/pulse_preload.c
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) $(PULSE_DEFINES) $(PULSE_INCLUDES) -c -o $@ $<

# --- static archive ---------------------------------------------------------
$(PULSE_LIB): $(PULSE_OBJS) $(PULSE_HELPER_OBJS) $(PULSE_MODULE_OBJS) $(PULSE_OBJ)/pulse_preload.o
	@echo "  AR      $@"
	@$(AR) rcs $@ $^

# Link the embedded PulseAudio daemon and its hard deps into ming64x.exe.
# Declared as prerequisites so $(TARGET)'s $^ carries them in dependency order:
# pulse -> ltdl -> sndfile -> regex (each consumer precedes its provider).
$(TARGET): $(PULSE_LIB) $(LTDLL_LIB) $(SNDFILE_LIB) $(REGEX_LIB)

# ---------------------------------------------------------------------------
# Create build directories
# ---------------------------------------------------------------------------
$(OBJ_SUBDIRS):
	mkdir -p $@

# ---------------------------------------------------------------------------
# Implicit rule: source tree .c -> build tree .o
# ---------------------------------------------------------------------------
$(OBJDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) $(DEFINES) $(INCLUDES) -c -o $@ $<

# ---------------------------------------------------------------------------
# Implicit rule: build tree .c -> build tree .o (for generated sources)
# ---------------------------------------------------------------------------
$(OBJDIR)/%.o: $(OBJDIR)/%.c
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) $(DEFINES) $(INCLUDES) -c -o $@ $<

# ---------------------------------------------------------------------------
# Windows resource: .rc -> .o (via windres)
# ---------------------------------------------------------------------------
$(XWIN_RES): $(XWIN_RC) hw/xwin/X.ico | $(FIXUP_HEADERS)
	@mkdir -p $(dir $@)
	@echo "  WINDRES $<"
	@$(WINDRES) $(DEFINES) --include-dir $(OBJDIR)/include --include-dir . --include-dir $(TOPSRCDIR)/include --include-dir $(PROJECTROOT) --include-dir $(TOPSRCDIR)/hw/xwin -i $< -o $@

$(LAUNCHX_RES): $(LAUNCHX_RC) hw/xwin/X.ico
	@mkdir -p $(dir $@)
	@echo "  WINDRES $<"
	@$(WINDRES) --include-dir $(TOPSRCDIR)/hw/xwin -i $< -o $@

# ---------------------------------------------------------------------------
# Explicit rules for generated sources (override pattern rule priority)
# ---------------------------------------------------------------------------
$(OBJDIR)/hw/xwin/winprefslex.o: $(OBJDIR)/hw/xwin/winprefslex.c
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) $(DEFINES) $(INCLUDES) -c -o $@ $<

$(OBJDIR)/hw/xwin/winprefsyacc.o: $(OBJDIR)/hw/xwin/winprefsyacc.c
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) $(DEFINES) $(INCLUDES) -c -o $@ $<

$(OBJDIR)/dix/initatoms.o: $(OBJDIR)/dix/initatoms.c
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) $(DEFINES) $(INCLUDES) -c -o $@ $<

# ---------------------------------------------------------------------------
# Flex/Bison: winprefs lexer and parser
# ---------------------------------------------------------------------------
$(OBJDIR)/hw/xwin/winprefslex.c: hw/xwin/winprefslex.l $(OBJDIR)/hw/xwin/winprefsyacc.h
	@mkdir -p $(dir $@)
	@echo "  FLEX    $<"
	@$(FLEX) -o $@ $<

$(OBJDIR)/hw/xwin/winprefsyacc.c $(OBJDIR)/hw/xwin/winprefsyacc.h: hw/xwin/winprefsyacc.y
	@mkdir -p $(dir $@)
	@echo "  BISON   $<"
	@$(BISON) -d -o $(OBJDIR)/hw/xwin/winprefsyacc.c $<

# ---------------------------------------------------------------------------
# Generated source: initatoms.c (needs bash)
# ---------------------------------------------------------------------------
$(OBJDIR)/dix/initatoms.c: dix/generate-atoms dix/BuiltInAtoms
	@mkdir -p $(dir $@)
	@echo "  GEN     $@"
	@bash dix/generate-atoms dix/BuiltInAtoms $@

# ---------------------------------------------------------------------------
# Generated GL/WGL wrappers (needs python3 + lxml)
# ---------------------------------------------------------------------------
GLX_GEN_SCRIPT := hw/xwin/glx/gen_gl_wrappers.py hw/xwin/glx/reg.py

$(OBJDIR)/hw/xwin/glx/generated_gl_wrappers.c: $(GLX_GEN_SCRIPT) hw/xwin/glx/gl.xml glx/dispatch.h
	@mkdir -p $(dir $@)
	@echo "  GEN     $@"
	@cd hw/xwin/glx && python3 gen_gl_wrappers.py -outfile $(abspath $@) -dispatchheader $(abspath glx/dispatch.h) -staticwrappers

$(OBJDIR)/hw/xwin/glx/generated_wgl_wrappers.c: $(GLX_GEN_SCRIPT) hw/xwin/glx/wgl.xml
	@mkdir -p $(dir $@)
	@echo "  GEN     $@"
	@cd hw/xwin/glx && python3 gen_gl_wrappers.py -registry wgl.xml -prefix wgl -outfile $(abspath $@) -preresolve -nodbgcount

$(OBJDIR)/hw/xwin/glx/glwrap.o:     $(OBJDIR)/hw/xwin/glx/generated_gl_wrappers.c
$(OBJDIR)/hw/xwin/glx/wgl_ext_api.o: $(OBJDIR)/hw/xwin/glx/generated_wgl_wrappers.c
