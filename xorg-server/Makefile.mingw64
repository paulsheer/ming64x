RECORD_OBJS := $(RECORD_SRCS:%.c=$(OBJDIR)/record/%.o)

# --- dbe ---
DBE_SRCS := dbe.c midbe.c
DBE_OBJS := $(DBE_SRCS:%.c=$(OBJDIR)/dbe/%.o)

# --- damageext ---
DAMAGEEXT_SRCS := damageext.c
DAMAGEEXT_OBJS := $(DAMAGEEXT_SRCS:%.c=$(OBJDIR)/damageext/%.o)

# --- composite ---
COMPOSITE_SRCS := compalloc.c compext.c compinit.c compoverlay.c compwindow.c
COMPOSITE_OBJS := $(COMPOSITE_SRCS:%.c=$(OBJDIR)/composite/%.o)

# --- present ---
PRESENT_SRCS := present.c present_event.c present_execute.c present_fake.c \
	present_fence.c present_notify.c present_request.c present_scmd.c \
	present_screen.c present_vblank.c
PRESENT_OBJS := $(PRESENT_SRCS:%.c=$(OBJDIR)/present/%.o)

# --- config ---
CONFIG_SRCS := config.c
CONFIG_OBJS := $(CONFIG_SRCS:%.c=$(OBJDIR)/config/%.o)

# --- pseudoramiX ---
PSEUDORAMIX_SRCS := pseudoramiX.c
PSEUDORAMIX_OBJS := $(PSEUDORAMIX_SRCS:%.c=$(OBJDIR)/pseudoramiX/%.o)

# --- xfixes ---
XFIXES_SRCS := cursor.c disconnect.c region.c saveset.c select.c xfixes.c
XFIXES_OBJS := $(XFIXES_SRCS:%.c=$(OBJDIR)/xfixes/%.o)

# --- glx (GLX extension) ---
GLX_SRCS := clientinfo.c createcontext.c extension_string.c glapi.c \
	glxcmds.c glxcmdsswap.c glxdricommon.c glxdriswrast.c glxext.c glxscreens.c \
	indirect_dispatch.c indirect_dispatch_swap.c indirect_program.c \
	indirect_reqsize.c indirect_size_get.c indirect_table.c \
	indirect_texture_compression.c indirect_util.c \
	render2.c render2swap.c renderpix.c renderpixswap.c rensize.c \
	single2.c single2swap.c singlepix.c singlepixswap.c singlesize.c \
	swap_interval.c vndcmds.c vndext.c \
	vndservermapping.c vndservervendor.c xfont.c
GLX_OBJS := $(GLX_SRCS:%.c=$(OBJDIR)/glx/%.o)

# --- hw/xwin/glx (WGL provider) ---
GLX_WIN_SRCS := glwrap.c indirect.c wgl_ext_api.c winpriv.c
GLX_WIN_OBJS := $(GLX_WIN_SRCS:%.c=$(OBJDIR)/hw/xwin/glx/%.o)

# --- hw/xwin (Windows DDX, with GLX) ---
XWIN_SRCS := InitInput.c InitOutput.c winallpriv.c winauth.c winblock.c \
	wincmap.c winconfig.c wincreatewnd.c wincursor.c windialogs.c \
	winengine.c winerror.c winglobals.c winkeybd.c winkeyhook.c winmisc.c \
	winmonitors.c winmouse.c winmsg.c winmsgwindow.c winmultiwindowclass.c \
	winmultiwindowicons.c winos.c winprefs.c winprocarg.c winscrinit.c \
	winshadddnl.c winshadgdi.c wintaskbar.c wintrayicon.c winvalargs.c \
	winwakeup.c winwindow.c winwndproc.c windisplay.c winclipboardinit.c \
	winclipboardwrappers.c winmultiwindowshape.c winmultiwindowwindow.c \
	winmultiwindowwm.c winmultiwindowwndproc.c winSetAppUserModelID.c \
	winrandr.c xdmcphostselect.c
XWIN_OBJS := $(XWIN_SRCS:%.c=$(OBJDIR)/hw/xwin/%.o)

# Windows resource file
XWIN_RES := $(OBJDIR)/hw/xwin/XWin.o
XWIN_RC  := hw/xwin/XWin.rc

# Generated flex/bison files append to XWIN_OBJS
XWIN_OBJS += $(OBJDIR)/hw/xwin/winprefslex.o $(OBJDIR)/hw/xwin/winprefsyacc.o

# --- hw/xwin/winclipboard ---
WINCLIP_SRCS := textconv.c thread.c wndproc.c xevents.c imageconv.c any2any.c dither.c
WINCLIP_OBJS := $(WINCLIP_SRCS:%.c=$(OBJDIR)/hw/xwin/winclipboard/%.o)

# --- giflib ---
GIFLIB_DIR := $(TOPSRCDIR)/giflib
GIFLIB_SRCS := dgif_lib.c egif_lib.c gifalloc.c gif_err.c gif_hash.c quantize.c
GIFLIB_OBJS := $(GIFLIB_SRCS:%.c=$(OBJDIR)/giflib/%.o)

# --- miext/damage ---
MIEXT_DAMAGE_SRCS := damage.c
MIEXT_DAMAGE_OBJS := $(MIEXT_DAMAGE_SRCS:%.c=$(OBJDIR)/miext/damage/%.o)

# --- miext/shadow ---
MIEXT_SHADOW_SRCS := shadow.c sh3224.c shafb4.c shafb8.c shiplan2p4.c \
	shiplan2p8.c shpacked.c shplanar8.c shplanar.c shrot16pack_180.c \
	shrot16pack_270.c shrot16pack_270YX.c shrot16pack_90.c \
	shrot16pack_90YX.c shrot16pack.c shrot32pack_180.c shrot32pack_270.c \
	shrot32pack_90.c shrot32pack.c shrot8pack_180.c shrot8pack_270.c \
	shrot8pack_90.c shrot8pack.c shrotate.c
