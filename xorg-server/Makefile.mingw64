# Makefile.mingw64 — Build the X.org X Server (ming64x.exe) for Windows
# using MinGW-w64. With OpenGL/Mesa support.
#
# Prerequisites:
#   MinGW-w64 toolchain (x86_64-w64-mingw32-gcc, ar, windres; or CLANG=1 for
#   the clang/lld toolchain at /opt/clang-mingw)
#   flex, bison (for winprefs lex/yacc)
#   Dependencies pre-built and installed under $(DEP_PREFIX):
#     zlib, pixman-1, freetype2, openssl, libX11, libxcb, libXau,
#     libXdmcp, libXfixes, libXfont2, libfontenc, libXinerama, pthreads

.DEFAULT_GOAL := help

# ---------------------------------------------------------------------------
# Toolchain
# ---------------------------------------------------------------------------
# CLANG=1 selects the clang/lld mingw-w64 toolchain at $(CLANG_PREFIX)
# (/opt/clang-mingw) instead of the default MinGW gcc toolchain.
CROSS      ?= x86_64-w64-mingw32-
CLANG_PREFIX ?= /opt/clang-mingw/bin
ifneq ($(CLANG),1)
CC         := $(CROSS)gcc
AR         := $(CROSS)ar
NM         := $(CROSS)nm
WINDRES    := $(CROSS)windres
else
CC         := $(CLANG_PREFIX)/$(CROSS)clang
AR         := $(CLANG_PREFIX)/$(CROSS)ar
NM         := $(CLANG_PREFIX)/$(CROSS)nm
WINDRES    := $(CLANG_PREFIX)/$(CROSS)windres
# clang-only warnings (gcc does not emit these)
CFLAGS     += -Wno-typedef-redefinition -Wno-deprecated-non-prototype
endif

# ASAN=1 enables AddressSanitizer; only supported with the clang/lld toolchain.
ASAN ?= 0
ifeq ($(ASAN),1)
ifeq ($(CLANG),1)
CFLAGS  += -fsanitize=address -fno-omit-frame-pointer
LDFLAGS += -fsanitize=address
else
$(error ASAN=1 requires CLANG=1)
endif
endif

FLEX       ?= flex
BISON      ?= bison
SED        := sed

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
TOPSRCDIR  := $(dir $(realpath $(lastword $(MAKEFILE_LIST))))
PROJECTROOT := $(realpath $(TOPSRCDIR)/..)
BUILDDIR   ?= build-mingw64
OBJDIR     := $(BUILDDIR)
DEP_PREFIX  ?= $(realpath $(TOPSRCDIR)/../../dep-ming64x/prefix)
DEP_ROOT    := $(realpath $(TOPSRCDIR)/../../dep-ming64x)

# Verify the five dependency sub-repos exist (they provide headers linked via -I$(DEP_PREFIX)/include)
DEP_REPOS   := libxcb-util libxcb-wm libxtrans xcb-proto xorgproto
MISSING      = $(strip $(foreach r,$(DEP_REPOS),$(if $(wildcard $(DEP_ROOT)/$(r)/.git),,$(r))))
ifneq ($(MISSING),)
$(info )
$(info ========================================)
$(info Missing dependency repositories in:)
$(info   $(DEP_ROOT))
$(info )
$(foreach r,$(MISSING),$(info   Missing: $(r)/))
$(info )
$(info To fix, run the following commands:)
$(info )
$(info   mkdir -p $(DEP_ROOT) && cd $(DEP_ROOT))
$(info   cd $(DEP_ROOT))
$(info   git clone https://gitlab.freedesktop.org/xorg/lib/libxcb-util.git)
$(info   git clone https://gitlab.freedesktop.org/xorg/lib/libxcb-wm.git)
$(info   git clone https://gitlab.freedesktop.org/xorg/lib/libxtrans.git)
$(info   git clone https://gitlab.freedesktop.org/xorg/proto/xcbproto.git xcb-proto)
$(info   git clone https://gitlab.freedesktop.org/xorg/proto/xorgproto.git)
$(info ========================================)
$(info )
$(info )
$(error Dependency check failed — see above for instructions)
$(info )
endif

# Verify the pulseaudio source tree is present and at release v17.0.
# Sentinel: pulseaudio/NEWS, whose first line must read "PulseAudio 17.0".
PULSE_ROOT := $(PROJECTROOT)/pulseaudio
PULSE_NEWS := $(PULSE_ROOT)/NEWS
PULSE_WANT := PulseAudio 17.0 custom
PULSE_HAVE := $(strip $(shell head -n 1 $(PULSE_NEWS) 2>/dev/null))

PULSE_OK := 0
ifneq ($(wildcard $(PULSE_NEWS)),)
ifeq ($(PULSE_HAVE),$(PULSE_WANT))
PULSE_OK := 1
endif
endif

ifeq ($(PULSE_OK),0)
$(info )
$(info ========================================)
$(info PulseAudio source tree missing or wrong version.)
$(info   Expected first line of $(PULSE_NEWS):)
$(info     "$(PULSE_WANT)")
$(info   Found:)
$(info     "$(if $(wildcard $(PULSE_NEWS)),$(PULSE_HAVE),<missing pulseaudio/NEWS>)")
$(info )
$(info To fix, clone pulseaudio and check out release v17.0-custom:)
$(info )
$(info   cd $(PROJECTROOT))
$(info   git clone https://github.com/paulsheer/pulseaudio.git)
$(info   cd pulseaudio && git checkout v17.0-custom)
$(info ========================================)
$(info )
$(error PulseAudio check failed - see above for instructions)
endif

# Verify the libltdl source tree (GNU libtool's libltdl) is present and correct.
# Sentinels: ltdl.c/ltdl.h + the Windows LoadLibrary loader + lt__argz.c (the
# latter identifies libtool >= 2.5.0, where argz.c was renamed to lt__argz.c).
LTDLL_ROOT := $(PROJECTROOT)/libltdl
LTDLL_WANT := libtool 2.5.4
LTDLL_FILES := ltdl.c ltdl.h loaders/loadlibrary.c loaders/preopen.c lt__argz.c
LTDLL_MISSING := $(strip $(foreach f,$(LTDLL_FILES),$(if $(wildcard $(LTDLL_ROOT)/$(f)),,$(f))))

ifneq ($(LTDLL_MISSING),)
$(info )
$(info ========================================)
$(info libltdl source tree missing or wrong version.)
$(info   Expected $(LTDLL_WANT) unpacked at:)
$(info     $(LTDLL_ROOT)/)
$(info )
$(foreach f,$(LTDLL_MISSING),$(info   Missing: libltdl/$(f)))
$(info )
$(info To fix, download libtool and unpack its libltdl/ subdirectory:)
$(info )
$(info   cd $(PROJECTROOT))
$(info   curl -LO https://ftp.gnu.org/gnu/libtool/libtool-2.5.4.tar.xz)
$(info   tar -xJf libtool-2.5.4.tar.xz)
$(info   rm -rf libltdl && mkdir -p libltdl)
$(info   cp -a libtool-2.5.4/libltdl/. libltdl/)
$(info   rm -rf libtool-2.5.4 libtool-2.5.4.tar.xz)
$(info ========================================)
$(info )
$(error libltdl check failed - see above for instructions)
endif

# Verify the libsndfile source tree is present and at release 1.2.2.
SNDFILE_ROOT := $(PROJECTROOT)/libsndfile
SNDFILE_WANT := 1.2.2
SNDFILE_FILES := src/sndfile.c include/sndfile.h src/common.h src/config.h.in
SNDFILE_MISSING := $(strip $(foreach f,$(SNDFILE_FILES),$(if $(wildcard $(SNDFILE_ROOT)/$(f)),,$(f))))
SNDFILE_HAVE := $(strip $(shell sed -n 's/^AC_INIT.*\[\([0-9.]*\)\].*/\1/p' $(SNDFILE_ROOT)/configure.ac 2>/dev/null))

SNDFILE_OK := 0
ifneq ($(wildcard $(SNDFILE_ROOT)/configure.ac),)
ifeq ($(SNDFILE_MISSING),)
ifeq ($(SNDFILE_HAVE),$(SNDFILE_WANT))
SNDFILE_OK := 1
endif
endif
endif

ifeq ($(SNDFILE_OK),0)
$(info )
$(info ========================================)
$(info libsndfile source tree missing or wrong version.)
$(info   Expected version $(SNDFILE_WANT) unpacked at:)
$(info     $(SNDFILE_ROOT)/)
$(info )
$(foreach f,$(SNDFILE_MISSING),$(info   Missing: libsndfile/$(f)))
$(info   Found version: $(if $(SNDFILE_HAVE),$(SNDFILE_HAVE),<missing>))
$(info )
$(info To fix, download libsndfile and unpack it:)
$(info )
$(info   cd $(PROJECTROOT))
$(info   curl -LO https://github.com/libsndfile/libsndfile/releases/download/1.2.2/libsndfile-1.2.2.tar.xz)
$(info   tar -xJf libsndfile-1.2.2.tar.xz)
$(info   rm -rf libsndfile && mv libsndfile-1.2.2 libsndfile)
$(info   rm -f libsndfile-1.2.2.tar.xz)
$(info ========================================)
$(info )
$(error libsndfile check failed - see above for instructions)
endif

# ---------------------------------------------------------------------------
# Compiler & linker flags
# ---------------------------------------------------------------------------
OPT_FLAG := -O2 -ggdb -Wall
ifdef NOOPT
OPT_FLAG := -O0 -ggdb -Wall
endif

CFLAGS  += $(OPT_FLAG) -std=gnu99 -ffunction-sections
CFLAGS  += -D_WIN32_WINNT=0x0601   # Win7 minimum (avoids NTDDI issues)
CFLAGS  += -fno-strict-aliasing
CFLAGS  += -Wno-unused-but-set-variable -Wno-unused-function -Wno-unused-variable
LDFLAGS += -Wl,--gc-sections -Wl,--enable-auto-import -mwindows

# ---------------------------------------------------------------------------
# Defines
# ---------------------------------------------------------------------------
DEFINES := \
	-DWIN32 \
	-D_WIN32 \
	-D_WINDOWS \
	-DWINDOWS \
	-D__MINGW32__ \
	-D_POSIX_ \
	-DX_NOT_POSIX \
	-DHAVE_CONFIG_H \
	-D_BSD_SOURCE \
	-DHAVE_DIX_CONFIG_H \
	-DXFree86Server \
	-DXKB_IN_SERVER \
	-DHAVE_XWIN_CONFIG_H \
	-DRELOCATE_PROJECTROOT \
	-DXWIN_GLX_WINDOWS \
	-DREAD_FONTDIRS \
	-DHAVE_XKB_CONFIG_H \
	-DPIXMAN_API=

# ---------------------------------------------------------------------------
# Include paths
# ---------------------------------------------------------------------------
INCLUDES := \
	-I$(PROJECTROOT)/pthreadlight \
	-I$(OBJDIR)/include \
	-I. \
	-I$(TOPSRCDIR) \
	-I$(PROJECTROOT) \
	-I$(TOPSRCDIR)/include \
	-I$(TOPSRCDIR)/mi \
	-I$(TOPSRCDIR)/miext/damage \
	-I$(TOPSRCDIR)/miext/shadow \
	-I$(TOPSRCDIR)/miext/sync \
	-I$(TOPSRCDIR)/miext/rootless \
	-I$(TOPSRCDIR)/render \
	-I$(TOPSRCDIR)/damageext \
	-I$(TOPSRCDIR)/randr \
	-I$(TOPSRCDIR)/xfixes \
	-I$(TOPSRCDIR)/Xi \
	-I$(TOPSRCDIR)/fb \
	-I$(TOPSRCDIR)/Xext \
	-I$(TOPSRCDIR)/composite \
	-I$(TOPSRCDIR)/dri3 \
	-I$(TOPSRCDIR)/present \
	-I$(TOPSRCDIR)/record \
	-I$(TOPSRCDIR)/dbe \
	-I$(TOPSRCDIR)/config \
	-I$(TOPSRCDIR)/hw/xfree86/common \
	-I$(TOPSRCDIR)/dix \
	-I$(TOPSRCDIR)/os \
	-I$(TOPSRCDIR)/xkb \
	-I$(TOPSRCDIR)/hw/xwin \
	-I$(TOPSRCDIR)/hw/xwin/winclipboard \
	-I$(TOPSRCDIR)/glx \
	-I$(TOPSRCDIR)/hw/xwin/glx \
	-I$(TOPSRCDIR)/$(OBJDIR) \
	-idirafter /usr/include \
	-idirafter /usr/include/pixman-1 \
	-idirafter /usr/include/freetype2 \
	-I$(DEP_PREFIX)/include \
	-I$(DEP_PREFIX)/include/pixman-1 \
	-I$(DEP_PREFIX)/include/freetype2

# ---------------------------------------------------------------------------
# Libraries to link against
# ---------------------------------------------------------------------------
LIBS := \
	-Wl,--start-group \
	-L$(DEP_PREFIX)/lib \
	-lX11 -lxcb -lxcb-errors -lXau -lXdmcp -lXfixes -lXfont2 -lfontenc \
	-lXinerama -lfontconfig -lexpat -lpixman-1 -lfreetype -lz \
	-ldxguid \
	-lopengl32 \
	-lws2_32 -lgdi32 -lcomdlg32 -lole32 -lshlwapi -lshell32 \
	-ladvapi32 -luser32 -lkernel32 -lwinmm -lsetupapi -lcomctl32 \
	-luuid -loleaut32 -lodbc32 -lodbccp32 -ldwmapi -lksuser \
	-Wl,--end-group

# ---------------------------------------------------------------------------
# xkbcomp — libraries, linker flags, sources, objects
# ---------------------------------------------------------------------------
XKBCOMP_LDFLAGS := -Wl,--gc-sections -Wl,--enable-auto-import
XKBCOMP_LIBS := \
	-Wl,--start-group \
	-L$(DEP_PREFIX)/lib \
	-lxkbfile -lX11 -lxcb -lXau -lXdmcp \
	-lws2_32 \
	-Wl,--end-group

XKBCOMP_WRAPS := \
	-Wl,--wrap=CompileCompatMap \
	-Wl,--wrap=CompileSymbols \
	-Wl,--wrap=BindIndicators \
	-Wl,--wrap=XkbAllocCompatMap \
	-Wl,--wrap=yylex \
	-Wl,--wrap=InterpCreate

XKBCOMP_SRCDIR := $(PROJECTROOT)/xkbcomp
XKBCOMP_SRCS := action.c alias.c compat.c expr.c geometry.c indicators.c \
	keycodes.c keymap.c keytypes.c listing.c misc.c parseutils.c symbols.c \
	utils.c vmod.c xkbcomp.c xkbpath.c xkbscan.c
XKBCOMP_OBJS := $(XKBCOMP_SRCS:%.c=$(OBJDIR)/xkbcomp/%.o)
XKBCOMP_OBJS += $(OBJDIR)/xkbcomp/xkbparse.o
XKBCOMP_OBJS += $(OBJDIR)/debug_wraps.o
XKBCOMP_OBJS += $(OBJDIR)/StrKeysym.o
XKBCOMP_OBJS += $(OBJDIR)/lcUTF8Load.o
XKBCOMP_OBJS += $(OBJDIR)/lcDefConv.o
XKBCOMP_OBJS += $(OBJDIR)/lcGenConv.o
XKBCOMP_OBJS += $(OBJDIR)/XlibInt.o
XKBCOMP_OBJS += $(OBJDIR)/xlibint_imp_aliases.o

XKBCOMP_DEFINES := \
	-DDFLT_XKB_CONFIG_ROOT='"."' \
	-DPACKAGE_VERSION='"1.2.3"' \
	-DPACKAGE_NAME='"xkbcomp"'

XKBCOMP_TARGET := $(OBJDIR)/xkbcomp.exe

# ---------------------------------------------------------------------------
# Patched headers (fix MSVC-isms for MinGW)
# ---------------------------------------------------------------------------
$(OBJDIR)/include/dix-config.h: $(PROJECTROOT)/include/dix-config.h
	@mkdir -p $(dir $@)
	@echo "  FIXUP   $< -> $@"
	@$(SED) \
		-e 's/#define HAVE_DLFCN_H 1/#undef HAVE_DLFCN_H/' \
		-e 's/#define HAVE_SETITIMER 1/#undef HAVE_SETITIMER/' \
		-e 's/#undef HYPERV/#define HYPERV 1/' \
		-e '/^#define strcasecmp _stricmp$$/d' \
		-e '/^#define strncasecmp _strnicmp$$/d' \
		-e '/^const char \*inet_ntop.*socklen_t cnt);$$/d' \
		-e '/^int inet_pton.*const char \*src.*void \*dst);$$/d' \
		$< > $@
	@echo '' >> $@
	@echo '/* MinGW: _sigset_t for os.h sigset_t typedef */' >> $@
	@echo '#ifndef _XORG_DIX_CONFIG_SIGSET_T' >> $@
	@echo '#define _XORG_DIX_CONFIG_SIGSET_T' >> $@
	@echo 'typedef unsigned long long _sigset_t;' >> $@
	@echo '#endif /* _XORG_DIX_CONFIG_SIGSET_T */' >> $@

$(OBJDIR)/include/stdint.h: $(PROJECTROOT)/include/stdint.h
	@mkdir -p $(dir $@)
	@echo "  FIXUP   $< -> $@"
	@echo '/* MinGW: redirect to system <stdint.h> */' > $@
	@echo '#include_next <stdint.h>' >> $@

$(OBJDIR)/include/unistd.h: $(PROJECTROOT)/include/unistd.h
	@mkdir -p $(dir $@)
	@echo "  FIXUP   $< -> $@"
	@tr '\\' '/' < $< | $(SED) \
		-e '/^#define strcasecmp _stricmp$$/d' \
		-e '/^#define strdup _strdup$$/d' > $@.tmp
	@echo '#define Pid_t pid_t' >> $@.tmp
	@mv $@.tmp $@

$(OBJDIR)/include/xcb: $(PROJECTROOT)/include/xcb
	@mkdir -p $@
	@echo "  COPY    $< -> $@"
	@cp -r $</* $@/
	@# Fix xcb_windefs.h: remove MSVC typedef that conflicts with MinGW sys/types.h
	@$(SED) -i '/^typedef int pid_t;$$/d' $@/xcb_windefs.h
	@# Fix XCB_EXTERN for static linking (not DLL)
	@$(SED) -i 's/__declspec(dllimport) extern/extern/g' $@/xcb_windefs.h
	@$(SED) -i 's/__declspec(dllexport) extern/extern/g' $@/xcb_windefs.h

$(OBJDIR)/include/KHR: $(PROJECTROOT)/include/KHR
	@mkdir -p $@
	@echo "  COPY    $< -> $@"
	@cp -r $</* $@/

$(OBJDIR)/include/GL/internal: $(PROJECTROOT)/mesalib/include/GL/internal
	@mkdir -p $@
	@echo "  COPY    $< -> $@"
	@cp -r $</* $@/

# Fix X11/Xlibint.h: patch X11_EXTERN from dllimport/dllexport to plain extern for static linking
$(OBJDIR)/include/X11/Xlibint.h: $(PROJECTROOT)/X11/Xlibint.h
	@mkdir -p $(dir $@)
	@echo "  FIXUP   $< -> $@"
	@cp $< $@
	@$(SED) -i 's/__declspec(dllimport) extern/extern/g' $@
	@$(SED) -i 's/__declspec(dllexport) extern/extern/g' $@

FIXUP_HEADERS := $(OBJDIR)/include/dix-config.h \
	$(OBJDIR)/include/stdint.h \
	$(OBJDIR)/include/unistd.h \
	$(OBJDIR)/include/xcb \
	$(OBJDIR)/include/KHR \
	$(OBJDIR)/include/GL/internal \
	$(OBJDIR)/include/X11/Xlibint.h

# ---------------------------------------------------------------------------
# Source files — dix
# ---------------------------------------------------------------------------
DIX_SRCS := display.c atom.c colormap.c color.c cursor.c devices.c \
	dispatch.c dixfonts.c main.c dixutils.c enterleave.c events.c \
	eventconvert.c extension.c gc.c getevents.c gestures.c globals.c \
	glyphcurs.c grabs.c initatoms.c inpututils.c pixmap.c privates.c \
	property.c ptrveloc.c region.c registry.c resource.c selection.c \
	swaprep.c swapreq.c tables.c touch.c window.c
DIX_OBJS := $(DIX_SRCS:%.c=$(OBJDIR)/dix/%.o)

# --- os ---
OS_SRCS := WaitFor.c access.c auth.c backtrace.c client.c connection.c \
	inputthread.c io.c mitauth.c osinit.c ospoll.c utils.c strcasecmp.c \
	timingsafe_memcmp.c strcasestr.c xdmauth.c xsha1.c opensslsha1.c xstrans.c xprintf.c \
	reallocarray.c alloc.c fmt.c string.c serverlock.c log.c xdmcp.c \
